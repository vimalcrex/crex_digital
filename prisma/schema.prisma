// CREX Digital - Database Schema
// Prisma schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

enum UserRole {
  ADMIN       // CREX Digital staff
  CUSTOMER    // Property owners/managers
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  password      String?
  name          String?
  image         String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(PENDING)

  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  accounts       Account[]
  sessions       Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// ORGANIZATIONS & PROPERTIES
// ============================================================================

enum OrganizationType {
  MULTIFAMILY    // Apartment communities
  COMMERCIAL     // Office, retail, industrial
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  type        OrganizationType
  website     String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zip         String?

  // Stripe billing
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  setupFeePaid         Boolean   @default(false)

  // Relations
  users      User[]
  properties Property[]
  campaigns  Campaign[]
  invoices   Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

enum PropertyType {
  APARTMENT
  STUDENT_HOUSING
  SENIOR_LIVING
  BUILD_TO_RENT
  OFFICE
  RETAIL
  INDUSTRIAL
  MIXED_USE
}

enum PropertyStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Property {
  id          String         @id @default(cuid())
  name        String
  type        PropertyType
  status      PropertyStatus @default(ACTIVE)

  // Location
  address     String
  city        String
  state       String
  zip         String
  latitude    Float?
  longitude   Float?

  // Property details
  units       Int?           // For multifamily
  sqft        Int?           // For commercial
  yearBuilt   Int?
  amenities   String[]       // Array of amenity names
  description String?        @db.Text

  // Lead routing
  leadEmail   String?        // Where to send leads
  leadWebhook String?        // Webhook URL for leads
  websiteUrl  String?        // Client's website

  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  campaigns      Campaign[]
  landingPages   LandingPage[]
  leads          Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("properties")
}

// ============================================================================
// CAMPAIGNS & ADS
// ============================================================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignGoal {
  LEASING          // Fill vacancies
  LEASE_UP         // New property launch
  ACQUISITION      // Attract buyers
  DISPOSITION      // Sell property
  BRAND_AWARENESS  // General awareness
}

enum AdPlatform {
  GOOGLE
  FACEBOOK
  LINKEDIN
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  status      CampaignStatus @default(DRAFT)
  goal        CampaignGoal

  // Budget
  dailyBudget    Decimal    @db.Decimal(10, 2)
  totalBudget    Decimal?   @db.Decimal(10, 2)

  // Targeting
  targetLocations String[]   // ZIP codes or city names
  targetRadius    Int?       // Miles from property
  targetAudiences String[]   // Audience segment names

  // Schedule
  startDate   DateTime?
  endDate     DateTime?

  // Relations
  organization   Organization   @relation(fields: [organizationId], references: [id])
  organizationId String
  property       Property       @relation(fields: [propertyId], references: [id])
  propertyId     String
  adAccounts     AdAccount[]
  adMetrics      AdMetric[]
  landingPage    LandingPage?   @relation(fields: [landingPageId], references: [id])
  landingPageId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaigns")
}

model AdAccount {
  id          String     @id @default(cuid())
  platform    AdPlatform
  accountId   String     // External platform account ID
  accountName String?

  // OAuth tokens (encrypted)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  tokenExpiry  DateTime?

  // Platform-specific IDs
  externalCampaignId String?
  externalAdSetId    String?
  externalAdId       String?

  // Relations
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, campaignId])
  @@map("ad_accounts")
}

model AdMetric {
  id          String     @id @default(cuid())
  platform    AdPlatform
  date        DateTime   @db.Date

  // Metrics
  impressions Int        @default(0)
  clicks      Int        @default(0)
  spend       Decimal    @db.Decimal(10, 2) @default(0)
  conversions Int        @default(0)

  // Calculated (stored for performance)
  ctr         Decimal?   @db.Decimal(5, 4)  // Click-through rate
  cpc         Decimal?   @db.Decimal(10, 2) // Cost per click
  cpa         Decimal?   @db.Decimal(10, 2) // Cost per acquisition

  // Relations
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String

  createdAt DateTime @default(now())

  @@unique([campaignId, platform, date])
  @@map("ad_metrics")
}

// ============================================================================
// LANDING PAGES & LEADS
// ============================================================================

enum LandingPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LandingPageTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  thumbnail   String?  // Preview image URL

  // Template configuration
  category    String   // e.g., "multifamily", "commercial"
  layout      String   // Template layout identifier
  defaultData Json     // Default content/settings

  // Relations
  landingPages LandingPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("landing_page_templates")
}

model LandingPage {
  id          String            @id @default(cuid())
  slug        String            @unique
  status      LandingPageStatus @default(DRAFT)

  // Content
  title       String
  headline    String?
  subheadline String?
  heroImage   String?
  content     Json              // Flexible content blocks

  // SEO
  metaTitle       String?
  metaDescription String?

  // A/B Testing
  variants    Json?             // A/B test variants
  activeVariant String?         // Current winning variant

  // Analytics
  views       Int     @default(0)
  submissions Int     @default(0)

  // Relations
  template   LandingPageTemplate? @relation(fields: [templateId], references: [id])
  templateId String?
  property   Property             @relation(fields: [propertyId], references: [id])
  propertyId String
  campaigns  Campaign[]
  leads      Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?

  @@map("landing_pages")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  status      LeadStatus @default(NEW)

  // Contact info
  firstName   String?
  lastName    String?
  email       String
  phone       String?

  // Lead details
  message     String?    @db.Text
  moveInDate  DateTime?
  bedrooms    Int?
  budget      Decimal?   @db.Decimal(10, 2)

  // Attribution
  source      String?    // e.g., "google", "facebook", "direct"
  medium      String?    // e.g., "cpc", "organic"
  campaign    String?    // UTM campaign
  adPlatform  AdPlatform?

  // Routing
  forwardedAt DateTime?  // When sent to client
  forwardedTo String?    // Email/webhook where sent

  // Relations
  property      Property    @relation(fields: [propertyId], references: [id])
  propertyId    String
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id])
  landingPageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

// ============================================================================
// BILLING
// ============================================================================

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Invoice {
  id          String        @id @default(cuid())
  status      InvoiceStatus @default(PENDING)

  // Stripe
  stripeInvoiceId String?   @unique

  // Amounts
  setupFee    Decimal?      @db.Decimal(10, 2)
  platformFee Decimal?      @db.Decimal(10, 2)
  adSpend     Decimal?      @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)

  // Period
  periodStart DateTime
  periodEnd   DateTime

  // Payment
  paidAt      DateTime?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

// ============================================================================
// AI & OPTIMIZATION
// ============================================================================

model AIRecommendation {
  id          String   @id @default(cuid())
  type        String   // e.g., "budget_rebalance", "creative_refresh", "audience_expansion"
  title       String
  description String   @db.Text

  // Recommendation data
  data        Json     // Specific recommendation details
  impact      String?  // Expected impact description
  confidence  Decimal? @db.Decimal(3, 2) // 0.00 to 1.00

  // Status
  applied     Boolean  @default(false)
  appliedAt   DateTime?
  dismissed   Boolean  @default(false)

  // Relations - polymorphic (can relate to campaign, landing page, etc.)
  entityType  String   // "campaign", "landing_page", "property"
  entityId    String

  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@map("ai_recommendations")
}

model ABTest {
  id          String   @id @default(cuid())
  name        String

  // Test configuration
  variants    Json     // Array of variant configs
  trafficSplit Json    // Traffic allocation per variant

  // Results
  results     Json?    // Per-variant metrics
  winner      String?  // Winning variant ID

  // Status
  status      String   @default("running") // running, completed, stopped
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  // Relations
  landingPageId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ab_tests")
}
